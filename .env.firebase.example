# Kopiraj v .env.firebase (je v .gitignore) in izpolni. Uporablja ga compose.firebase.yaml prek --env-file.
# V repozitorij ne gre nič od tega (gitleaks prepreči commit).
FIREBASE_PROJECT_ID=contact-manager-sdd-6bd9b
FIREBASE_AUTH_DOMAIN=contact-manager-sdd-6bd9b.firebaseapp.com
# Firebase Console → Project settings → General → Your apps → Web app → apiKey
FIREBASE_API_KEY=
# Absolutna pot do JSON ključa storitvenega računa (vloga Firebase Authentication Admin), izven repozitorija.
FIREBASE_SERVICE_ACCOUNT_FILE=
# UID:GID lastnika ključa (ukaz `id -u` in `id -g`); ključ ostane chmod 600, zaledje teče kot ta uporabnik.
FIREBASE_CONTAINER_UID=1000
FIREBASE_CONTAINER_GID=1000
# Naslov za HTTPS (caddy): javna domena strežnika (npr. kontakti.example.com ali 203-0-113-10.sslip.io) za potrdilo
# Let's Encrypt; localhost = samopodpisano potrdilo Caddyja. Domeno dodaj tudi v Firebase → Authentication → Authorized domains.
SITE_ADDRESS=localhost
