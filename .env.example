# Kopiraj v .env. Spremenljivke z vrednostjo so razvojni privzetki (brez .env veljajo te vrednosti); prazne so obvezne.
# V repozitorij ne gredo pravi ključi ali gesla (.env je v .gitignore, gitleaks prepreči commit).
POSTGRES_DB=contacts
POSTGRES_USER=contacts
POSTGRES_PASSWORD=contacts

# 019 API ključi: podpisni ključ (base64, vsaj 32 bajtov), obvezen. Ustvari ga z ukazom: openssl rand -base64 32
# Zamenjava vrednosti razveljavi vse API ključe. ./verify.sh e2e in CI ob manjkajoči vrednosti ustvarita začasno.
API_KEY_SIGNING_SECRET=
