{
  "name": "contact-manager-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@tabler/icons-react": "3.50.0",
    "clsx": "2.1.1",
    "firebase": "13.2.0",
    "i18next": "26.7.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "react-router": "8.5.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
  }
}
